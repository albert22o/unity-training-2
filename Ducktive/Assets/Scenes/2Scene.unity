  dialogueText: {fileID: 703474460}
  lines:
  - characterName: "\u0423\u0442\u043A\u0430-\u0422\u0438\u0432"
    text: "\u0416\u0443\u0442\u043A\u043E-\u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0449\u0438\u0435
      \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0438\u0437 \u0432\u043E\u0441\u043A\u0430."
  - characterName: "\u0423\u0442\u043A\u0430-\u0422\u0438\u0432"
    text: "\u0420\u0430\u043D\u044C\u0448\u0435 \u043C\u0443\u0437\u0435\u0439 \u0432\u043E\u0441\u043A\u043E\u0432\u044B\u0445
      \u0444\u0438\u0433\u0443\u0440 \u0431\u044B\u043B \u043E\u0447\u0435\u043D\u044C
      \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D, \u043F\u043E\u043A\u0430
      \u0421\u0442\u044D\u043D \u043F\u0440\u043E \u043D\u0435\u0433\u043E \u043D\u0435
      \u0437\u0430\u0431\u044B\u043B \u0434\u043E \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
  - characterName: "\u0423\u0442\u043A\u0430-\u0422\u0438\u0432"
    text: "\u0422\u0443\u0442 \u0435\u0441\u0442\u044C \u0427\u0438\u043D\u0433\u0438\u0441\u0445\u0430\u043D
      \u0438 \u0428\u0435\u0440\u043B\u043E\u043A \u0425\u043E\u043B\u043C\u0441,
      \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435."
