  dialogueText: {fileID: 703474460}
  lines:
  - characterName: "\u0420\u0435\u043F\u043E\u0440\u0442\u0430\u0436 \u043D\u0430
      \u043F\u043E\u043B\u0443"
    text: "\u0422\u041E\u0420\u0416\u0415\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0415
      \u041E\u0422\u041A\u0420\u042B\u0422\u0418\u0415 \u041C\u0423\u0417\u0415\u042F
      \u0412\u041E\u0421\u041A\u041E\u0412\u042B\u0425 \u0424\u0418\u0413\u0423\u0420
      \u0425\u0418\u0416\u0418\u041D\u042B \u0427\u0423\u0414\u0415\u0421 \u041E\u0411\u0415\u0420\u041D\u0423\u041B\u041E\u0421\u042C
      \u041A\u0410\u0422\u0410\u0421\u0422\u0420\u041E\u0424\u041E\u0419"
  - characterName: "\u0420\u0435\u043F\u043E\u0440\u0442\u0430\u0436 \u043D\u0430
      \u043F\u043E\u043B\u0443"
    text: "\u041C\u0443\u0437\u0435\u0439 \u0432\u043E\u0441\u043A\u043E\u0432\u044B\u0445
      \u0444\u0438\u0433\u0443\u0440 \u0413\u0440\u0430\u0432\u0438\u0442\u0438 \u0424\u043E\u043B\u0437
      \u0432 \u0425\u0438\u0436\u0438\u043D\u0435 \u0427\u0443\u0434\u0435\u0441
      \u0432\u043D\u043E\u0432\u044C \u043E\u0442\u043A\u0440\u044B\u043B \u0441\u0432\u043E\u0438
      \u0434\u0432\u0435\u0440\u0438 \u0434\u043B\u044F \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439,
      \u043D\u043E \u0433\u0440\u043E\u043C\u043A\u043E\u0435 \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0435
      \u043E\u0447\u0435\u0440\u043D\u0438\u043B\u043E \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C."
  - characterName: "\u0420\u0435\u043F\u043E\u0440\u0442\u0430\u0436 \u043D\u0430
      \u043F\u043E\u043B\u0443"
    text: "\u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043B\u044E\u0434\u0435\u0439 \u043F\u0440\u0438\u0448\u043B\u0438 \u043D\u0430
      \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F,
      \u043D\u043E \u043F\u043E \u0435\u0433\u043E \u0445\u043E\u0434\u0443 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u041C\u0438\u0441\u0442\u0435\u0440
      \u0417\u0430\u0433\u0430\u0434\u043A\u0430 \u0421\u0442\u044D\u043D \u041F\u0430\u0438\u043D\u0441
      \u0432\u0441\u0435\u0445 \u043E\u0431\u043C\u0430\u043D\u0443\u043B: \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044F\u043C
      \u043E\u0431\u0435\u0449\u0430\u043B\u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0443\u044E
      \u043F\u0438\u0446\u0446\u0443, \u043D\u043E \u043D\u0438\u043A\u0442\u043E
      \u0435\u0435 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B. "
  - characterName: "\u0420\u0435\u043F\u043E\u0440\u0442\u0430\u0436 \u043D\u0430
      \u043F\u043E\u043B\u0443"
    text: "\u041C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C
      \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432. \u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0438
      \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u044B. "
  - characterName: "\u0420\u0435\u043F\u043E\u0440\u0442\u0430\u0436 \u043D\u0430
      \u043F\u043E\u043B\u0443"
    text: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0444\u043E\u043D\u0435, \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u044D\u0442\u043E\u0433\u043E \u0436\u0435 \u0434\u043D\u044F \u0432 \u0425\u0438\u0436\u0438\u043D\u0435
      \u0427\u0443\u0434\u0435\u0441 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044F: \u0432\u043E\u0441\u043A\u043E\u0432\u043E\u0439
      \u0421\u0442\u044D\u043D \u041F\u0430\u0438\u043D\u0441 \u0431\u044B\u043B
      \u043D\u0430\u0439\u0434\u0435\u043D \u043E\u0431\u0435\u0437\u0433\u043B\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u043C
      \u0432 \u0441\u0432\u043E\u0435\u0439 \u0433\u043E\u0441\u0442\u0438\u043D\u043D\u043E\u0439.
      \u041F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u0430 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
      \u0438\u0449\u0443\u0442."
